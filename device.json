{
  "title": "J-Novel Club",
  "token": {
    "file": "token.json",
    "path": "id"
  },
  "config": {
    "file": "config.json"
  },
  "auth": {
    "type": "password",
    "request": {
      "url": "https://labs.j-novel.club/app/v2/auth/login?format=json",
      "method": "POST",
      "headers": {
        "Accept": "application/json",
        "Content-Type": "application/json"
      },
      "body": "{\"login\":\"{cfg.email}\",\"password\":\"{cfg.password}\",\"slim\":true}"
    },
    "token_path": "id"
  },
  "browse": {
    "format": "json",
    "url": "https://labs.j-novel.club/app/v2/me/library?include=serie&format=json&skip={page}0&limit={limit}",
    "method": "GET",
    "headers": {
      "Accept": "application/json",
      "Authorization": "Bearer {token}"
    },
    "items": "books",
    "fields": {
      "title": "volume.title",
      "author": "downloads.0.type",
      "id": "volume.id"
    },
    "page_size": 10,
    "lists": [
      {
        "title": "Latest 10",
        "url": "https://labs.j-novel.club/app/v2/me/library?include=serie&format=json&skip=0&limit=10"
      },
      {
        "title": "Older volumes",
        "url": "https://labs.j-novel.club/app/v2/me/library?include=serie&format=json&skip={page}0&limit={limit}"
      }
    ]
  },
  "download": {
    "url": "{cfg.api_base}/app/v2/me/library/volume/{id}?include=serie&format=json",
    "method": "GET",
    "headers": {
      "Accept": "application/json",
      "Authorization": "Bearer {token}",
      "X-Optimizer-Key": "{cfg.server_key}"
    },
    "url_path": "downloads.0.link",
    "dest_dir": "/J-Novel Club",
    "filename": "{title}.epub"
  },
  "description": "Your library, 10 volumes a page. Full library: web page, Settings.",
  "author": "Megu",
  "version": "1.5.1"
}
